{
  "manifest_version": 3,
  "name": "DuskBloom Web",
  "version": "2.0.0",
  "description": "Low-memory migraine-friendly web comfort themes with clean preset switching and custom colors.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "DuskBloom Web",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "flower-16.png",
      "32": "flower-32.png",
      "48": "flower-48.png",
      "96": "flower-96.png",
      "128": "flower-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-migraine-filter": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Toggle Migraine Filter on this site"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "flower-16.png",
    "32": "flower-32.png",
    "48": "flower-48.png",
    "96": "flower-96.png",
    "128": "flower-128.png"
  }
}